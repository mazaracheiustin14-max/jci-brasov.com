{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jci-brasov-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "jci-brasov-inscrieri", "database_id": "1c3fb6c6-db88-48a5-9bb9-7fe7349d3d81" }
  ],
  "ai": { "binding": "AI" },
  "send_email": [
    { "name": "MAIL" }
  ],
  "observability": { "enabled": true }
}
