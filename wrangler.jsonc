{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jci-brasov-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "send_email": [
    { "name": "MAIL" }
  ],
  "observability": { "enabled": true }
}
